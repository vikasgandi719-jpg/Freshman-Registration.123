import React, { useState } from 'react';
import {
  View, Text, StyleSheet, SafeAreaView, ScrollView,
  TouchableOpacity, TextInput, Modal, Alert, Platform,
} from 'react-native';
import { useAdmin } from '../../context/AdminContext';
import { BRANCHES } from '../../constants/branches';

// ─── Team Data ────────────────────────────────────────────────────────────────
const BRANCH_CODES = BRANCHES.map((b) => b.shortName);

const generateTeam = () => {
  const branchAdmins = BRANCHES.map((b, i) => ({
    id: `ba_${i + 1}`,
    name: `${b.shortName} Branch Admin`,
    email: `${b.shortName.toLowerCase()}.admin@bvritn.ac.in`,
    role: 'BRANCH ADMIN',
    branch: b.shortName,
    color: b.color,
    active: true,
  }));

  const verificationOfficers = BRANCHES.flatMap((b, bi) =>
    [1, 2, 3].map((n, i) => ({
      id: `vo_${bi * 3 + i + 1}`,
      name: `Verification Officer ${bi * 3 + i + 1}`,
      email: `vo${bi * 3 + i + 1}@bvritn.ac.in`,
      role: 'VERIFICATION OFFICER',
      branch: b.shortName,
      color: '#7C3AED',
      active: true,
    }))
  );

  const documentManagers = BRANCHES.flatMap((b, bi) =>
    [1, 2].map((n, i) => ({
      id: `dm_${bi * 2 + i + 1}`,
      name: `Document Manager ${bi * 2 + i + 1}`,
      email: `dm${bi * 2 + i + 1}@bvritn.ac.in`,
      role: 'DOCUMENT MANAGER',
      branch: b.shortName,
      color: '#059669',
      active: true,
    }))
  );

  return { branchAdmins, verificationOfficers, documentManagers };
};

const initialTeam = generateTeam();

// ─── Role config ──────────────────────────────────────────────────────────────
const ROLE_CONFIG = {
  'BRANCH ADMIN': {
    label: 'BRANCH ADMIN',
    badgeColor: '#F59E0B',
    badgeBg:    '#FFFBEB',
    icon:       '🏫',
  },
  'VERIFICATION OFFICER': {
    label: 'VERIFICATION OFFICER',
    badgeColor: '#7C3AED',
    badgeBg:    '#F5F3FF',
    icon:       '✅',
  },
  'DOCUMENT MANAGER': {
    label: 'DOCUMENT MANAGER',
    badgeColor: '#059669',
    badgeBg:    '#F0FDF4',
    icon:       '📄',
  },
};

// ─── Member Card ──────────────────────────────────────────────────────────────
const MemberCard = ({ member, onEdit, onToggle }) => (
  <TouchableOpacity style={styles.memberCard} onPress={() => onEdit(member)} activeOpacity={0.8}>
    <View style={[styles.memberAvatar, { backgroundColor: member.color + '20' }]}>
      <Text style={[styles.memberAvatarText, { color: member.color }]}>
        {member.name.split(' ').map((w) => w[0]).join('').slice(0, 2).toUpperCase()}
      </Text>
    </View>
    <View style={styles.memberInfo}>
      <Text style={styles.memberName}>{member.name}</Text>
      <Text style={styles.memberEmail}>{member.email}</Text>
    </View>
    <View style={[styles.branchBadge, { borderColor: member.color + '40' }]}>
      <Text style={[styles.branchBadgeText, { color: member.color }]}>{member.branch}</Text>
    </View>
  </TouchableOpacity>
);

// ─── Section ─────────────────────────────────────────────────────────────────
const TeamSection = ({ role, members, onEdit, onAdd, searchQuery }) => {
  const config   = ROLE_CONFIG[role];
  const filtered = members.filter(
    (m) =>
      !searchQuery ||
      m.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
      m.branch.toLowerCase().includes(searchQuery.toLowerCase()) ||
      m.email.toLowerCase().includes(searchQuery.toLowerCase())
  );

  return (
    <View style={styles.section}>
      {/* Section Header */}
      <View style={styles.sectionHeader}>
        <View style={[styles.roleBadge, { backgroundColor: config.badgeBg }]}>
          <Text style={[styles.roleBadgeText, { color: config.badgeColor }]}>
            {config.label}
          </Text>
        </View>
        <View style={[styles.countBadge, { backgroundColor: config.badgeBg }]}>
          <Text style={[styles.countBadgeText, { color: config.badgeColor }]}>
            {filtered.length}
          </Text>
        </View>
        <TouchableOpacity
          style={[styles.addBtn, { backgroundColor: config.badgeBg }]}
          onPress={() => onAdd(role)}
        >
          <Text style={[styles.addBtnText, { color: config.badgeColor }]}>+ Add</Text>
        </TouchableOpacity>
      </View>

      {/* Members Grid */}
      <View style={styles.memberGrid}>
        {filtered.length === 0 ? (
          <Text style={styles.emptyText}>No members found.</Text>
        ) : (
          filtered.map((member) => (
            <View key={member.id} style={styles.memberGridItem}>
              <MemberCard member={member} onEdit={onEdit} />
            </View>
          ))
        )}
      </View>
    </View>
  );
};

// ─── Main Screen ──────────────────────────────────────────────────────────────
const TeamScreen = ({ navigation }) => {
  const { admin } = useAdmin();

  const [team, setTeam]               = useState(initialTeam);
  const [searchQuery, setSearchQuery] = useState('');
  const [activeTab, setActiveTab]     = useState('all');
  const [modalVisible, setModalVisible] = useState(false);
  const [editingMember, setEditingMember] = useState(null);
  const [addingRole, setAddingRole]     = useState(null);
  const [form, setForm] = useState({ name: '', email: '', branch: BRANCH_CODES[0], role: 'BRANCH ADMIN' });

  const allMembers = [
    ...team.branchAdmins,
    ...team.verificationOfficers,
    ...team.documentManagers,
  ];

  const tabs = [
    { id: 'all',                  label: 'All',          count: allMembers.length },
    { id: 'BRANCH ADMIN',         label: 'Branch Admin', count: team.branchAdmins.length },
    { id: 'VERIFICATION OFFICER', label: 'Verification', count: team.verificationOfficers.length },
    { id: 'DOCUMENT MANAGER',     label: 'Doc Manager',  count: team.documentManagers.length },
  ];

  const getList = (role) => {
    if (role === 'BRANCH ADMIN')         return team.branchAdmins;
    if (role === 'VERIFICATION OFFICER') return team.verificationOfficers;
    if (role === 'DOCUMENT MANAGER')     return team.documentManagers;
    return [];
  };

  const setList = (role, list) => {
    if (role === 'BRANCH ADMIN')         setTeam((t) => ({ ...t, branchAdmins: list }));
    if (role === 'VERIFICATION OFFICER') setTeam((t) => ({ ...t, verificationOfficers: list }));
    if (role === 'DOCUMENT MANAGER')     setTeam((t) => ({ ...t, documentManagers: list }));
  };

  const openEdit = (member) => {
    setEditingMember(member);
    setForm({ name: member.name, email: member.email, branch: member.branch, role: member.role });
    setModalVisible(true);
  };

  const openAdd = (role) => {
    setEditingMember(null);
    setAddingRole(role);
    setForm({ name: '', email: '', branch: BRANCH_CODES[0], role });
    setModalVisible(true);
  };

  const handleSave = () => {
    if (!form.name.trim() || !form.email.trim()) {
      if (Platform.OS === 'web') {
        window.alert('Please fill in name and email.');
      } else {
        Alert.alert('Error', 'Please fill in name and email.');
      }
      return;
    }

    const roleConfig = ROLE_CONFIG[form.role];
    const color = BRANCHES.find((b) => b.shortName === form.branch)?.color || '#1D4ED8';

    if (editingMember) {
      // Update existing
      const list    = getList(editingMember.role);
      const updated = list.map((m) =>
        m.id === editingMember.id
          ? { ...m, name: form.name.trim(), email: form.email.trim(), branch: form.branch, color }
          : m
      );
      setList(editingMember.role, updated);
    } else {
      // Add new
      const list   = getList(form.role);
      const newMember = {
        id:     `${form.role.toLowerCase().replace(/ /g, '_')}_${Date.now()}`,
        name:   form.name.trim(),
        email:  form.email.trim(),
        role:   form.role,
        branch: form.branch,
        color,
        active: true,
      };
      setList(form.role, [...list, newMember]);
    }
    setModalVisible(false);
  };

  const handleDelete = () => {
    const doDelete = () => {
      const list    = getList(editingMember.role);
      const updated = list.filter((m) => m.id !== editingMember.id);
      setList(editingMember.role, updated);
      setModalVisible(false);
    };

    if (Platform.OS === 'web') {
      if (window.confirm(`Remove ${editingMember.name}?`)) doDelete();
    } else {
      Alert.alert('Remove Member', `Remove ${editingMember.name}?`, [
        { text: 'Cancel', style: 'cancel' },
        { text: 'Remove', style: 'destructive', onPress: doDelete },
      ]);
    }
  };

  const visibleRoles =
    activeTab === 'all'
      ? ['BRANCH ADMIN', 'VERIFICATION OFFICER', 'DOCUMENT MANAGER']
      : [activeTab];

  return (
    <SafeAreaView style={styles.safe}>

      {/* Header */}
      <View style={styles.header}>
        <TouchableOpacity onPress={() => navigation.goBack()} style={styles.backBtn}>
          <Text style={styles.backBtnText}>‹</Text>
        </TouchableOpacity>
        <View>
          <Text style={styles.headerTitle}>Team</Text>
          <Text style={styles.headerSub}>{allMembers.length} members</Text>
        </View>
      </View>

      {/* Search */}
      <View style={styles.searchBox}>
        <Text style={styles.searchIcon}>🔍</Text>
        <TextInput
          style={styles.searchInput}
          placeholder="Search by name, branch, email..."
          placeholderTextColor="#94A3B8"
          value={searchQuery}
          onChangeText={setSearchQuery}
        />
        {searchQuery ? (
          <TouchableOpacity onPress={() => setSearchQuery('')}>
            <Text style={styles.searchClear}>✕</Text>
          </TouchableOpacity>
        ) : null}
      </View>

      {/* Tabs */}
      <ScrollView horizontal showsHorizontalScrollIndicator={false} style={styles.tabsScroll} contentContainerStyle={styles.tabs}>
        {tabs.map((tab) => (
          <TouchableOpacity
            key={tab.id}
            style={[styles.tab, activeTab === tab.id && styles.tabActive]}
            onPress={() => setActiveTab(tab.id)}
          >
            <Text style={[styles.tabText, activeTab === tab.id && styles.tabTextActive]}>
              {tab.label}
            </Text>
            <View style={[styles.tabCount, activeTab === tab.id && styles.tabCountActive]}>
              <Text style={[styles.tabCountText, activeTab === tab.id && styles.tabCountTextActive]}>
                {tab.count}
              </Text>
            </View>
          </TouchableOpacity>
        ))}
      </ScrollView>

      {/* Content */}
      <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={styles.content}>
        {visibleRoles.map((role) => (
          <TeamSection
            key={role}
            role={role}
            members={getList(role)}
            onEdit={openEdit}
            onAdd={openAdd}
            searchQuery={searchQuery}
          />
        ))}
        <View style={{ height: 40 }} />
      </ScrollView>

      {/* Add / Edit Modal */}
      <Modal visible={modalVisible} transparent animationType="slide" onRequestClose={() => setModalVisible(false)}>
        <View style={styles.modalOverlay}>
          <View style={styles.modalBox}>

            <Text style={styles.modalTitle}>
              {editingMember ? 'Edit Member' : `Add ${form.role}`}
            </Text>

            {/* Name */}
            <Text style={styles.fieldLabel}>Full Name</Text>
            <TextInput
              style={styles.fieldInput}
              placeholder="Enter full name"
              value={form.name}
              onChangeText={(t) => setForm((f) => ({ ...f, name: t }))}
            />

            {/* Email */}
            <Text style={styles.fieldLabel}>Email</Text>
            <TextInput
              style={styles.fieldInput}
              placeholder="Enter email"
              value={form.email}
              onChangeText={(t) => setForm((f) => ({ ...f, email: t }))}
              keyboardType="email-address"
              autoCapitalize="none"
            />

            {/* Branch */}
            <Text style={styles.fieldLabel}>Branch</Text>
            <ScrollView horizontal showsHorizontalScrollIndicator={false} style={{ marginBottom: 16 }}>
              {BRANCH_CODES.map((code) => (
                <TouchableOpacity
                  key={code}
                  style={[styles.branchChip, form.branch === code && styles.branchChipActive]}
                  onPress={() => setForm((f) => ({ ...f, branch: code }))}
                >
                  <Text style={[styles.branchChipText, form.branch === code && styles.branchChipTextActive]}>
                    {code}
                  </Text>
                </TouchableOpacity>
              ))}
            </ScrollView>

            {/* Role (only when adding) */}
            {!editingMember && (
              <>
                <Text style={styles.fieldLabel}>Role</Text>
                <View style={styles.roleRow}>
                  {Object.keys(ROLE_CONFIG).map((role) => (
                    <TouchableOpacity
                      key={role}
                      style={[styles.roleChip, form.role === role && { backgroundColor: ROLE_CONFIG[role].badgeBg, borderColor: ROLE_CONFIG[role].badgeColor }]}
                      onPress={() => setForm((f) => ({ ...f, role }))}
                    >
                      <Text style={[styles.roleChipText, form.role === role && { color: ROLE_CONFIG[role].badgeColor }]}>
                        {ROLE_CONFIG[role].icon} {role.split(' ')[0]}
                      </Text>
                    </TouchableOpacity>
                  ))}
                </View>
              </>
            )}

            {/* Buttons */}
            <View style={styles.modalBtns}>
              {editingMember && (
                <TouchableOpacity style={styles.deleteBtnModal} onPress={handleDelete}>
                  <Text style={styles.deleteBtnModalText}>Remove</Text>
                </TouchableOpacity>
              )}
              <TouchableOpacity style={styles.cancelBtn} onPress={() => setModalVisible(false)}>
                <Text style={styles.cancelBtnText}>Cancel</Text>
              </TouchableOpacity>
              <TouchableOpacity style={styles.saveBtn} onPress={handleSave}>
                <Text style={styles.saveBtnText}>{editingMember ? 'Save' : 'Add'}</Text>
              </TouchableOpacity>
            </View>

          </View>
        </View>
      </Modal>

    </SafeAreaView>
  );
};

