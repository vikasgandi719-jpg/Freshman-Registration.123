# ─── Required in production ───────────────────────────────────────────────────
# Long random string — sessions invalidate if you change this.
JWT_SECRET=

# Postgres connection string.
DATABASE_URL=postgres://user:password@localhost:5432/bvritn

# Comma-separated list of allowed origins for CORS.
# Example: https://app.bvritn.ac.in,https://admin.bvritn.ac.in
CORS_ORIGIN=

# ─── Optional ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
JWT_EXPIRES_IN=7d
DB_POOL_MAX=10

# Cloudinary — needed for real document uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
