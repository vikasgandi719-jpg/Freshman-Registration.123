## Backend environment variables
## Copy this file to `.env` and fill in real values.

# PostgreSQL connection string (must include password)
# Format: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgres://postgres:your_password@localhost:5432/freshman_registration

# JWT
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Node
NODE_ENV=development

# Cloudinary (for document uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

